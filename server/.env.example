# HTTP bind
HOST=0.0.0.0
PORT=8080
# Local SQLite store: ON by default. Set to false to disable (no DB file, /codes and /export.json return 404).
QR_DB_ENABLED=true
# SQLite file path (local only). Default ./data/qrcodes.db (in Docker: /app/data/qrcodes.db)
QR_DB_PATH=./data/qrcodes.db
# Max characters of data per code
QR_MAX_DATA=2048
